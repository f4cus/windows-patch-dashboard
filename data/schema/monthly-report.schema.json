{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:windows-patch-dashboard:schema:monthly-report:1.0.0",
  "title": "Windows Patch Dashboard Monthly Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "reportMonth",
    "patchTuesdayDate",
    "generatedAt",
    "status",
    "updates"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "reportMonth": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "patchTuesdayDate": {
      "type": "string",
      "format": "date"
    },
    "generatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "manual-golden-fixture",
        "generated",
        "partial",
        "verified"
      ]
    },
    "updates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/update"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "generated",
              "partial",
              "verified"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updates": {
            "items": {
              "required": [
                "sources"
              ],
              "properties": {
                "sources": {
                  "minItems": 1,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/source"
                      },
                      {
                        "required": [
                          "retrievedAt"
                        ],
                        "properties": {
                          "retrievedAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "manual-golden-fixture"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "generatedAt"
        ],
        "properties": {
          "reportMonth": {
            "const": "2026-08"
          },
          "patchTuesdayDate": {
            "const": "2026-08-11"
          },
          "generatedAt": {
            "const": null
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "microsoft-support",
            "msrc",
            "release-health"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "retrievedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "microsoft-support"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://support\\.microsoft\\.com/"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "msrc"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://(?:api\\.)?msrc\\.microsoft\\.com/"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "release-health"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://learn\\.microsoft\\.com/"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "os": {
      "type": "object",
      "required": [
        "family",
        "version",
        "channel",
        "displayName"
      ],
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "Windows Server",
            "Windows 11"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "family": {
              "const": "Windows Server"
            },
            "version": {
              "const": "2012"
            },
            "channel": {
              "const": "ESU"
            },
            "displayName": {
              "const": "Windows Server 2012 (ESU)"
            }
          }
        },
        {
          "properties": {
            "family": {
              "const": "Windows Server"
            },
            "version": {
              "const": "2012 R2"
            },
            "channel": {
              "const": "ESU"
            },
            "displayName": {
              "const": "Windows Server 2012 R2 (ESU)"
            }
          }
        },
        {
          "properties": {
            "family": {
              "const": "Windows Server"
            },
            "version": {
              "const": "2016"
            },
            "channel": {
              "const": null
            },
            "displayName": {
              "const": "Windows Server 2016"
            }
          }
        },
        {
          "properties": {
            "family": {
              "const": "Windows Server"
            },
            "version": {
              "const": "2019"
            },
            "channel": {
              "const": null
            },
            "displayName": {
              "const": "Windows Server 2019"
            }
          }
        },
        {
          "properties": {
            "family": {
              "const": "Windows Server"
            },
            "version": {
              "const": "2022"
            },
            "channel": {
              "const": null
            },
            "displayName": {
              "const": "Windows Server 2022"
            }
          }
        },
        {
          "properties": {
            "family": {
              "const": "Windows Server"
            },
            "version": {
              "const": "23H2"
            },
            "channel": {
              "const": null
            },
            "displayName": {
              "const": "Windows Server, version 23H2"
            }
          }
        },
        {
          "properties": {
            "family": {
              "const": "Windows Server"
            },
            "version": {
              "const": "2025"
            },
            "channel": {
              "const": null
            },
            "displayName": {
              "const": "Windows Server 2025"
            }
          }
        },
        {
          "properties": {
            "family": {
              "const": "Windows 11"
            },
            "version": {
              "pattern": "^[0-9]{2}H[12](?:/[0-9]{2}H[12])*$"
            },
            "channel": {
              "const": null
            },
            "displayName": {
              "pattern": "^Windows 11 [0-9]{2}H[12](?:/[0-9]{2}H[12])*$"
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "update": {
      "type": "object",
      "required": [
        "kb",
        "os",
        "updateType",
        "releaseDate",
        "changesSummary",
        "resolvedIssuesSummary",
        "knownIssuesSummary",
        "knownIssuesStatus",
        "supersededBy"
      ],
      "properties": {
        "kb": {
          "type": "string",
          "pattern": "^(KB[0-9]+|NO PUBLICADO)$"
        },
        "os": {
          "$ref": "#/$defs/os"
        },
        "updateType": {
          "type": "string",
          "enum": [
            "security",
            "oob",
            "preview",
            "unknown"
          ]
        },
        "releaseDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "changesSummary": {
          "type": "string",
          "minLength": 1
        },
        "resolvedIssuesSummary": {
          "type": "string",
          "minLength": 1
        },
        "knownIssuesSummary": {
          "type": "string",
          "minLength": 1
        },
        "knownIssuesStatus": {
          "type": "string",
          "enum": [
            "none",
            "open",
            "resolved",
            "not-published",
            "unknown"
          ]
        },
        "supersededBy": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^KB[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kb": {
                "const": "NO PUBLICADO"
              }
            },
            "required": [
              "kb"
            ]
          },
          "then": {
            "properties": {
              "releaseDate": {
                "const": null
              },
              "knownIssuesStatus": {
                "const": "not-published"
              },
              "supersededBy": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "knownIssuesStatus": {
                "not": {
                  "const": "not-published"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
